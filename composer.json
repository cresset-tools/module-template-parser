{
    "name": "cresset/module-template-parser",
    "description": "Parse-to-AST template directive engine for Magento/Mage-OS, installable as a module",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "require": {
        "php": "~8.3.0||~8.4.0||~8.5.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/string": "^7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Cresset\\TemplateParser\\": "src/"
        },
        "files": [
            "registration.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Cresset\\TemplateParser\\Test\\": "tests/"
        }
    },
    "suggest": {
        "magento/framework": "Required only for the src/Magento adapters; the engine itself has no Magento dependency",
        "n98/magerun2": "Lists the module's bin/magento commands (template:*) once the module is enabled"
    },
    "archive": {
        "exclude": [
            "/tests",
            "/tools",
            "/.github",
            "/phpunit.xml",
            "/.phpunit.cache",
            "/vendor",
            "/composer.lock"
        ]
    },
    "bin": [
        "bin/template-parser"
    ],
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    }
}
