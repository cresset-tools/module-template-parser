<?xml version="1.0"?>
<!--
    Wiring only. Installing this module changes no rendering behaviour by itself:
    nothing here declares a preference for Magento\Framework\Filter\Template.

    To evaluate the engine against your own content, construct a ShadowComparator with
    enabled=true and call it from wherever you render templates. To adopt the engine, add
    your own preference in a project module once shadow mode reports no divergence.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <preference for="Cresset\TemplateParser\Port\Translator"
                type="Cresset\TemplateParser\Magento\PhraseTranslator"/>

    <preference for="Cresset\TemplateParser\Magento\TemplateFilterInterface"
                type="Cresset\TemplateParser\Magento\TemplateFilterAdapter"/>

    <!--
        The plugin is NOT registered here. Adopting this engine is a decision for the
        integrator, taken after running shadow mode over real content, so it is declared in
        a project module against whichever filter you want to cover:

            <type name="Magento\Email\Model\Template\Filter">
                <plugin name="cresset_template_parser" sortOrder="10"
                        type="Cresset\TemplateParser\Magento\Plugin\TemplateFilterPlugin"/>
            </type>

        Even then nothing changes until ShadowComparator below is enabled, and while it is
        enabled the LEGACY result is what gets returned.
    -->

    <!--
        The ports the adapter renders through.

        Without these HostServices defaults every port to null, so the adapter registers only
        the directives that need no host - and an email template hitting {{css}} or
        {{template}} raises "No handler registered". Shadow mode over the 48 stock email
        templates did exactly that 118 times before this existed: the Magento adapters were
        all written, all tested, and nothing connected them to the class that renders.

        Wiring them changes no behaviour on its own. The adapter is only reached once an
        integrator declares the plugin, which this file deliberately does not.
    -->
    <!--
        Every OPTIONAL object dependency, named explicitly.

        A nullable constructor argument with a default of null is left null by DI unless it is
        configured here - the type alone is not an instruction to resolve it. So each of these
        classes was silently running in its degraded mode: ConfigTemplateLoader without a
        TemplateFactory returns null for every include, which is how {{template}} rendered
        nothing and every stock email lost its header and footer. The others lose the country
        name, the theme, and the published-asset read.

        They are nullable so the engine still loads on a tree that lacks the class. This is
        what supplies them where it exists.
    -->
    <type name="Cresset\TemplateParser\Magento\ConfigTemplateLoader">
        <arguments>
            <argument name="templateFactory" xsi:type="object">Magento\Email\Model\TemplateFactory</argument>
        </arguments>
    </type>

    <type name="Cresset\TemplateParser\Magento\AllowlistedConfigReader">
        <arguments>
            <argument name="storeInformation" xsi:type="object">Magento\Store\Model\Information</argument>
            <argument name="storeManager" xsi:type="object">Magento\Store\Model\StoreManagerInterface</argument>
        </arguments>
    </type>

    <type name="Cresset\TemplateParser\Magento\AssetStylesheetLoader">
        <arguments>
            <argument name="design" xsi:type="object">Magento\Framework\View\DesignInterface</argument>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem</argument>
        </arguments>
    </type>

    <type name="Cresset\TemplateParser\HostServices">
        <arguments>
            <argument name="blocks" xsi:type="object">Cresset\TemplateParser\Magento\LayoutBlockRenderer</argument>
            <argument name="translator" xsi:type="object">Cresset\TemplateParser\Magento\PhraseTranslator</argument>
            <argument name="templates" xsi:type="object">Cresset\TemplateParser\Magento\ConfigTemplateLoader</argument>
            <argument name="config" xsi:type="object">Cresset\TemplateParser\Magento\AllowlistedConfigReader</argument>
            <argument name="customVariables" xsi:type="object">Cresset\TemplateParser\Magento\VariableCustomVariableReader</argument>
            <argument name="urls" xsi:type="object">Cresset\TemplateParser\Magento\StoreUrlBuilder</argument>
            <argument name="stylesheets" xsi:type="object">Cresset\TemplateParser\Magento\AssetStylesheetLoader</argument>
            <argument name="layouts" xsi:type="object">Cresset\TemplateParser\Magento\AllowlistedLayoutRenderer</argument>
            <argument name="widgets" xsi:type="object">Cresset\TemplateParser\Magento\TypeCheckedWidgetRenderer</argument>
            <argument name="templateUrls" xsi:type="object">Cresset\TemplateParser\Magento\TemplateModelUrlBuilder</argument>
        </arguments>
    </type>

    <type name="Cresset\TemplateParser\Magento\TemplateFilterAdapter">
        <arguments>
            <argument name="services" xsi:type="object">Cresset\TemplateParser\HostServices</argument>
        </arguments>
    </type>

    <type name="Cresset\TemplateParser\Magento\LayoutBlockRenderer">
        <arguments>
            <!-- Only these methods may be named by {{block output="..."}}. -->
            <argument name="allowedOutputMethods" xsi:type="array">
                <item name="toHtml" xsi:type="string">toHtml</item>
            </argument>
            <!--
                The store's own deny list for this directive, reused rather than reimplemented:
                a rule added to Magento_Email's di.xml applies here too. The constructor takes
                it loosely typed so a tree without the class still loads; this argument is what
                supplies it where it exists. Remove this line on such a tree.
            -->
            <argument name="blockDirectivePolicy" xsi:type="object">Magento\Email\Model\Template\Filter\BlockDirectivePolicy</argument>
        </arguments>
    </type>

    <type name="Cresset\TemplateParser\Magento\ConfigTemplateLoader">
        <arguments>
            <argument name="allowedPathPrefixes" xsi:type="array">
                <item name="email" xsi:type="string">design/email/</item>
            </argument>
        </arguments>
    </type>

    <!--
        AllowlistedLayoutRenderer takes a REQUIRED array. Without an entry here it compiles
        clean and then throws BadMethodCallException the first time anything asks for it,
        because DI has no value to supply. Empty by design: a layout handle decides which
        blocks get built, so the integrator names the ones they trust.
    -->
    <type name="Cresset\TemplateParser\Magento\AllowlistedLayoutRenderer">
        <arguments>
            <argument name="allowedHandles" xsi:type="array"/>
        </arguments>
    </type>

    <type name="Cresset\TemplateParser\Magento\ShadowComparator">
        <arguments>
            <argument name="enabled" xsi:type="boolean">false</argument>
        </arguments>
    </type>
</config>
