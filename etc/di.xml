<?xml version="1.0"?>
<!--
    Wiring only. Installing this module changes no rendering behaviour by itself:
    nothing here declares a preference for Magento\Framework\Filter\Template.

    To evaluate the engine against your own content, construct a ShadowComparator with
    enabled=true and call it from wherever you render templates. To adopt the engine, add
    your own preference in a project module once shadow mode reports no divergence.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <preference for="Cresset\TemplateParser\Port\Translator"
                type="Cresset\TemplateParser\Magento\PhraseTranslator"/>

    <preference for="Cresset\TemplateParser\Magento\TemplateFilterInterface"
                type="Cresset\TemplateParser\Magento\TemplateFilterAdapter"/>

    <!--
        The plugin is NOT registered here. Adopting this engine is a decision for the
        integrator, taken after running shadow mode over real content, so it is declared in
        a project module against whichever filter you want to cover:

            <type name="Magento\Email\Model\Template\Filter">
                <plugin name="cresset_template_parser" sortOrder="10"
                        type="Cresset\TemplateParser\Magento\Plugin\TemplateFilterPlugin"/>
            </type>

        Even then nothing changes until ShadowComparator below is enabled, and while it is
        enabled the LEGACY result is what gets returned.
    -->

    <type name="Cresset\TemplateParser\Magento\LayoutBlockRenderer">
        <arguments>
            <!-- Only these methods may be named by {{block output="..."}}. -->
            <argument name="allowedOutputMethods" xsi:type="array">
                <item name="toHtml" xsi:type="string">toHtml</item>
            </argument>
            <!--
                The store's own deny list for this directive, reused rather than reimplemented:
                a rule added to Magento_Email's di.xml applies here too. The constructor takes
                it loosely typed so a tree without the class still loads; this argument is what
                supplies it where it exists. Remove this line on such a tree.
            -->
            <argument name="blockDirectivePolicy" xsi:type="object">Magento\Email\Model\Template\Filter\BlockDirectivePolicy</argument>
        </arguments>
    </type>

    <type name="Cresset\TemplateParser\Magento\ConfigTemplateLoader">
        <arguments>
            <argument name="allowedPathPrefixes" xsi:type="array">
                <item name="email" xsi:type="string">design/email/</item>
            </argument>
        </arguments>
    </type>

    <!--
        AllowlistedLayoutRenderer takes a REQUIRED array. Without an entry here it compiles
        clean and then throws BadMethodCallException the first time anything asks for it,
        because DI has no value to supply. Empty by design: a layout handle decides which
        blocks get built, so the integrator names the ones they trust.
    -->
    <type name="Cresset\TemplateParser\Magento\AllowlistedLayoutRenderer">
        <arguments>
            <argument name="allowedHandles" xsi:type="array"/>
        </arguments>
    </type>

    <type name="Cresset\TemplateParser\Magento\ShadowComparator">
        <arguments>
            <argument name="enabled" xsi:type="boolean">false</argument>
        </arguments>
    </type>
</config>
