<?xml version="1.0"?>
<!--
    Installing this module wires it, and changes no rendering behaviour.

    The plugin below is declared on Magento\Framework\Filter\Template, so it sits on every
    email, CMS and newsletter render, and on the customer and store address formats. What it does there is read `system/template_engine/mode` for the
    render's store (etc/config.xml defaults it to legacy) and, under Legacy, return. Rollout is
    a configuration change per store view - Stores > Configuration > Advanced > System >
    Template Engine - not a di.xml edit in a project module.

    Nothing here declares a preference for Magento\Framework\Filter\Template, and nothing
    should: the filters that render are concrete subclasses DI builds directly, so a
    preference for the base class never applies. See TemplateFilterPlugin.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <preference for="MageOS\TemplateParser\Port\Translator"
                type="MageOS\TemplateParser\Magento\PhraseTranslator"/>

    <preference for="MageOS\TemplateParser\Magento\TemplateFilterInterface"
                type="MageOS\TemplateParser\Magento\TemplateFilterAdapter"/>

    <!--
        On the framework base class, which every template filter extends - a plugin on a class
        applies to its subclasses. That covers the Email filter and the CMS, Widget and
        Newsletter filters built on it, and the plain filter FilterManager::template() builds
        for address formats. Any other subclass is handed straight to the filter by the plugin
        itself; see TemplateFilterPlugin.
    -->
    <type name="Magento\Framework\Filter\Template">
        <plugin name="mageos_template_parser" sortOrder="10"
                type="MageOS\TemplateParser\Magento\Plugin\TemplateFilterPlugin"/>
    </type>
    <!--
        The Email filter's own setters - the plain-text flag and the design - which the plugin
        above needs and cannot declare itself: Magento's compiler refuses a plugin method for a
        method the class it is declared on lacks. See EmailFilterStatePlugin.
    -->
    <type name="Magento\Email\Model\Template\Filter">
        <plugin name="mageos_template_parser_state"
                type="MageOS\TemplateParser\Magento\Plugin\EmailFilterStatePlugin"/>
    </type>

    <!--
        Which template a render was. The filter is handed a string and never learns where it
        came from, so these register an identity against the text as the models hand it over,
        and the filter plugin looks it up by the source it was given. Without them every Shadow
        row would be "unidentified", and a report could say that something diverged but not
        what to open. See Shadow\TemplateIdentity.

        Newsletter's model extends AbstractTemplate, so the first covers newsletter bodies too.
        Subjects are declared on the concrete email model, because that is where
        getProcessedTemplateSubject() is.
    -->
    <type name="Magento\Email\Model\AbstractTemplate">
        <plugin name="mageos_template_parser_identity"
                type="MageOS\TemplateParser\Magento\Plugin\EmailTemplateIdentityPlugin"/>
    </type>
    <type name="Magento\Email\Model\Template">
        <plugin name="mageos_template_parser_subject_identity"
                type="MageOS\TemplateParser\Magento\Plugin\EmailSubjectIdentityPlugin"/>
    </type>
    <type name="Magento\Newsletter\Model\Template">
        <plugin name="mageos_template_parser_subject_identity"
                type="MageOS\TemplateParser\Magento\Plugin\NewsletterSubjectIdentityPlugin"/>
    </type>
    <type name="Magento\Newsletter\Model\Queue">
        <plugin name="mageos_template_parser_identity"
                type="MageOS\TemplateParser\Magento\Plugin\NewsletterQueueIdentityPlugin"/>
    </type>
    <type name="Magento\Cms\Model\Block">
        <plugin name="mageos_template_parser_identity"
                type="MageOS\TemplateParser\Magento\Plugin\CmsBlockIdentityPlugin"/>
    </type>
    <type name="Magento\Cms\Model\Page">
        <plugin name="mageos_template_parser_identity"
                type="MageOS\TemplateParser\Magento\Plugin\CmsPageIdentityPlugin"/>
    </type>
    <type name="Magento\Catalog\Helper\Output">
        <plugin name="mageos_template_parser_identity"
                type="MageOS\TemplateParser\Magento\Plugin\CatalogOutputIdentityPlugin"/>
    </type>
    <!-- Address formats render through FilterManager, so these hold a name for the call. -->
    <type name="Magento\Customer\Block\Address\Renderer\DefaultRenderer">
        <plugin name="mageos_template_parser_identity"
                type="MageOS\TemplateParser\Magento\Plugin\AddressIdentityPlugin"/>
    </type>
    <type name="Magento\Store\Model\Address\Renderer">
        <plugin name="mageos_template_parser_identity"
                type="MageOS\TemplateParser\Magento\Plugin\StoreAddressIdentityPlugin"/>
    </type>

    <!--
        The ports the adapter renders through.

        Without these HostServices defaults every port to null, so the adapter registers only
        the directives that need no host - and an email template hitting {{css}} or
        {{template}} raises "No handler registered". Shadow mode over the 48 stock email
        templates did exactly that 118 times before this existed: the Magento adapters were
        all written, all tested, and nothing connected them to the class that renders.

        Wiring them changes no behaviour on its own. The adapter is only reached for a render
        whose store is set to Shadow.
    -->
    <!--
        Every OPTIONAL object dependency, named explicitly.

        A nullable constructor argument with a default of null is left null by DI unless it is
        configured here - the type alone is not an instruction to resolve it. So each of these
        classes was silently running in its degraded mode: ConfigTemplateLoader without a
        TemplateFactory returns null for every include, which is how {{template}} rendered
        nothing and every stock email lost its header and footer. The others lose the country
        name, the theme, and the published-asset read.

        They are nullable so the engine still loads on a tree that lacks the class. This is
        what supplies them where it exists.
    -->
    <type name="MageOS\TemplateParser\Magento\ConfigTemplateLoader">
        <arguments>
            <argument name="templateFactory" xsi:type="object">Magento\Email\Model\TemplateFactory</argument>
        </arguments>
    </type>

    <type name="MageOS\TemplateParser\Magento\AllowlistedConfigReader">
        <arguments>
            <argument name="storeInformation" xsi:type="object">Magento\Store\Model\Information</argument>
            <argument name="storeManager" xsi:type="object">Magento\Store\Model\StoreManagerInterface</argument>
        </arguments>
    </type>

    <type name="MageOS\TemplateParser\Magento\AssetStylesheetLoader">
        <arguments>
            <argument name="design" xsi:type="object">Magento\Framework\View\DesignInterface</argument>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem</argument>
        </arguments>
    </type>

    <type name="MageOS\TemplateParser\HostServices">
        <arguments>
            <argument name="blocks" xsi:type="object">MageOS\TemplateParser\Magento\LayoutBlockRenderer</argument>
            <argument name="translator" xsi:type="object">MageOS\TemplateParser\Magento\PhraseTranslator</argument>
            <argument name="templates" xsi:type="object">MageOS\TemplateParser\Magento\ConfigTemplateLoader</argument>
            <argument name="config" xsi:type="object">MageOS\TemplateParser\Magento\AllowlistedConfigReader</argument>
            <argument name="customVariables" xsi:type="object">MageOS\TemplateParser\Magento\VariableCustomVariableReader</argument>
            <argument name="urls" xsi:type="object">MageOS\TemplateParser\Magento\StoreUrlBuilder</argument>
            <argument name="stylesheets" xsi:type="object">MageOS\TemplateParser\Magento\AssetStylesheetLoader</argument>
            <argument name="layouts" xsi:type="object">MageOS\TemplateParser\Magento\AllowlistedLayoutRenderer</argument>
            <argument name="widgets" xsi:type="object">MageOS\TemplateParser\Magento\TypeCheckedWidgetRenderer</argument>
            <argument name="templateUrls" xsi:type="object">MageOS\TemplateParser\Magento\TemplateModelUrlBuilder</argument>
            <!--
                {{mydir}} through the store's own SimpleDirective\ProcessorPool. Renders
                nothing on a store that registered no processor, which is every stock one.
            -->
            <argument name="customDirectives" xsi:type="object">MageOS\TemplateParser\Magento\PoolCustomDirectiveRenderer</argument>
        </arguments>
    </type>

    <!--
        The default URL model is the one Magento\Email\Model\Template gives its filter
        (Magento_Email's di.xml), rather than whatever UrlInterface the area prefers - in
        adminhtml that is the backend model, and an order email sent from the admin would have
        linked its customer into the admin. Inside a render, the filter's own model is used.
    -->
    <type name="MageOS\TemplateParser\Magento\StoreUrlBuilder">
        <arguments>
            <argument name="urlModel" xsi:type="object">Magento\Framework\Url</argument>
            <!-- The rendering filter's own URL model wins over that default; see RenderScope. -->
            <argument name="scope" xsi:type="object">MageOS\TemplateParser\Magento\RenderScope</argument>
        </arguments>
    </type>

    <!-- {{widget}} gets the rendering filter's store as store_id, as generateWidget does. -->
    <!-- The rendering filter's store and URL model, for the two ports above. -->
    <type name="MageOS\TemplateParser\Magento\Plugin\TemplateFilterPlugin">
        <arguments>
            <argument name="scope" xsi:type="object">MageOS\TemplateParser\Magento\RenderScope</argument>
            <argument name="plainComparator" xsi:type="object">MageOSTemplateParserPlainComparator</argument>
        </arguments>
    </type>

    <!--
        The plain filter's adapter. Its only host directives are the store's ProcessorPool
        ones, which the plain filter dispatches exactly as the Email filter does; everything
        else it renders as text, or - {{template}}, {{for}} - is declined. See
        Options::$plainFilter.
    -->
    <virtualType name="MageOSTemplateParserPlainServices" type="MageOS\TemplateParser\HostServices">
        <arguments>
            <!--
                A virtual type inherits the arguments of the type it is built on, so every port
                configured for HostServices above is cleared here by name; left out, the plain
                adapter would render {{block}} and {{store}} where the plain filter prints them.
            -->
            <argument name="blocks" xsi:type="null"/>
            <argument name="translator" xsi:type="null"/>
            <argument name="templates" xsi:type="null"/>
            <argument name="config" xsi:type="null"/>
            <argument name="customVariables" xsi:type="null"/>
            <argument name="urls" xsi:type="null"/>
            <argument name="stylesheets" xsi:type="null"/>
            <argument name="layouts" xsi:type="null"/>
            <argument name="widgets" xsi:type="null"/>
            <argument name="templateUrls" xsi:type="null"/>
            <argument name="customDirectives" xsi:type="object">MageOS\TemplateParser\Magento\PoolCustomDirectiveRenderer</argument>
        </arguments>
    </virtualType>
    <virtualType name="MageOSTemplateParserPlainAdapter" type="MageOS\TemplateParser\Magento\TemplateFilterAdapter">
        <arguments>
            <argument name="services" xsi:type="object">MageOSTemplateParserPlainServices</argument>
            <argument name="plainFilter" xsi:type="boolean">true</argument>
        </arguments>
    </virtualType>
    <virtualType name="MageOSTemplateParserPlainComparator" type="MageOS\TemplateParser\Magento\ShadowComparator">
        <arguments>
            <argument name="adapter" xsi:type="object">MageOSTemplateParserPlainAdapter</argument>
        </arguments>
    </virtualType>

    <type name="MageOS\TemplateParser\Magento\TypeCheckedWidgetRenderer">
        <arguments>
            <argument name="scope" xsi:type="object">MageOS\TemplateParser\Magento\RenderScope</argument>
        </arguments>
    </type>

    <type name="MageOS\TemplateParser\Magento\TemplateFilterAdapter">
        <arguments>
            <argument name="services" xsi:type="object">MageOS\TemplateParser\HostServices</argument>
        </arguments>
    </type>

    <type name="MageOS\TemplateParser\Magento\LayoutBlockRenderer">
        <arguments>
            <!-- Only these methods may be named by {{block output="..."}}. -->
            <argument name="allowedOutputMethods" xsi:type="array">
                <item name="toHtml" xsi:type="string">toHtml</item>
            </argument>
            <!--
                The store's own deny list for this directive, reused rather than reimplemented:
                a rule added to Magento_Email's di.xml applies here too. The constructor takes
                it loosely typed so a tree without the class still loads; this argument is what
                supplies it where it exists. Remove this line on such a tree.
            -->
            <argument name="blockDirectivePolicy" xsi:type="object">Magento\Email\Model\Template\Filter\BlockDirectivePolicy</argument>
        </arguments>
    </type>

    <type name="MageOS\TemplateParser\Magento\ConfigTemplateLoader">
        <arguments>
            <argument name="allowedPathPrefixes" xsi:type="array">
                <item name="email" xsi:type="string">design/email/</item>
            </argument>
        </arguments>
    </type>

    <!--
        AllowlistedLayoutRenderer takes a REQUIRED array. Without an entry here it compiles
        clean and then throws BadMethodCallException the first time anything asks for it,
        because DI has no value to supply.

        A layout handle decides which blocks get built, so template text may only name the
        handles listed here. These are the ones the stock sales emails build their item
        tables and tracking with. Every one is already reachable from a template the store
        ships, so allowing them grants nothing a stock installation does not already do - and
        without them Parser mode declines every order, invoice, shipment and credit memo email
        to the legacy filter. Add a module's own handles in your di.xml, keyed by name; a
        handle not listed is recorded as a policy violation, and Parser falls back for it.
    -->
    <type name="MageOS\TemplateParser\Magento\AllowlistedLayoutRenderer">
        <arguments>
            <argument name="allowedHandles" xsi:type="array">
                <item name="sales_email_order_items" xsi:type="string">sales_email_order_items</item>
                <item name="sales_email_order_invoice_items" xsi:type="string">sales_email_order_invoice_items</item>
                <item name="sales_email_order_shipment_items" xsi:type="string">sales_email_order_shipment_items</item>
                <item name="sales_email_order_shipment_track" xsi:type="string">sales_email_order_shipment_track</item>
                <item name="sales_email_order_creditmemo_items" xsi:type="string">sales_email_order_creditmemo_items</item>
            </argument>
        </arguments>
    </type>

    <!--
        The commands, under bin/magento as template:*. Each is the standalone command with the
        ObjectManager handed in; see Console\Magento\ObjectManagerBridge. CommandList builds
        every registered command on every bin/magento run, so their constructors do nothing
        but keep the ObjectManager.
    -->
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="mageos_template_check" xsi:type="object">MageOS\TemplateParser\Console\Magento\CheckCommand</item>
                <item name="mageos_template_diff" xsi:type="object">MageOS\TemplateParser\Console\Magento\DiffCommand</item>
                <item name="mageos_template_repl" xsi:type="object">MageOS\TemplateParser\Console\Magento\ReplCommand</item>
                <item name="mageos_template_parser_shadow_report" xsi:type="object">MageOS\TemplateParser\Console\Magento\ShadowReportCommand</item>
                <item name="mageos_template_parser_shadow_clear" xsi:type="object">MageOS\TemplateParser\Console\Magento\ShadowClearCommand</item>
                <item name="mageos_template_status" xsi:type="object">MageOS\TemplateParser\Console\Magento\StatusCommand</item>
            </argument>
        </arguments>
    </type>
</config>
