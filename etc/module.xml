<?xml version="1.0"?>
<!--
    The sequence is load order for configuration merging, and each entry is here for something
    this module's etc/ builds on: Backend declares the System section the setting is placed in,
    Config reads it, Store resolves the store a render is recorded against, and Email and Cms
    own the classes the plugins are declared on.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Cresset_TemplateParser" setup_version="0.1.0">
        <sequence>
            <module name="Magento_Backend"/>
            <module name="Magento_Cms"/>
            <module name="Magento_Config"/>
            <module name="Magento_Email"/>
            <module name="Magento_Store"/>
        </sequence>
    </module>
</config>
