<?php
declare(strict_types=1);

/**
 * Laminas\Filter\FilterInterface, which Framework\Filter\Template implements.
 *
 * Every declaration is guarded: inside a real installation the genuine classes exist and
 * redeclaring them is fatal.
 */

namespace Laminas\Filter;

if (!interface_exists(FilterInterface::class)) {
    interface FilterInterface { public function filter($value); }
}
