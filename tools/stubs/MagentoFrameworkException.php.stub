<?php
declare(strict_types=1);

/**
 * Framework\Exception\LocalizedException, which Math\Random raises on an invalid range.
 *
 * Every declaration is guarded: inside a real installation the genuine classes exist and
 * redeclaring them is fatal.
 */

namespace Magento\Framework\Exception;

if (!class_exists(LocalizedException::class)) {
    class LocalizedException extends \Exception {}
}
